// Copy to appsettings.json next to ServerComms.Bot.exe and fill in. Comments are allowed.
// The bot refuses to start, and says which setting is wrong, until the required values are set.
{
  "ServerComms": {
    // "ASA" or "ASE": one bot per game cluster.
    "Game": "ASA",

    "Discord": {
      // Bot token from the Discord developer portal (Bot > Reset Token). Keep this file private.
      "Token": "",
      // Your Discord server's ID (Developer Mode on, right-click the server > Copy Server ID).
      // Discord IDs are written in quotes so JSON tools can't round them.
      "GuildId": "0"
    },

    // The same servercomms database the plugins on this cluster use.
    "Database": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "User": "servercomms",
      "Password": "",
      "Name": "servercomms"
    },

    // Two-way chat between global chat on every map and one Discord channel.
    // In the Discord developer portal, Bot > "Message Content Intent" must be on, or the bot sees
    // empty messages.
    "Crosschat": {
      "Enabled": true,
      // Right-click the channel > Copy Channel ID.
      "ChannelId": "0",
      // {time} {platform} {map} {name} {tribe} {tag} {message}. {tribe} uses TribeFormat and
      // disappears for players without a tribe. ASE example:
      //   "[{time}][{map}] **{name}**{tribe}: {message}"
      "LineFormat": "[{time}] {platform} **[{map}] {name}{tribe}**: {message}",
      "TribeFormat": " [{tribe}]",
      "TimeFormat": "yyyy-MM-dd HH:mm:ss",
      // Lines arriving within this many seconds are posted as one Discord message.
      "BatchSeconds": 2,
      "PollSeconds": 1,
      // Discord messages are cut to this length before they go in game.
      "MaxLengthToGame": 250,
      // After an outage, only the last this-many lines are posted, with a note about the rest.
      "MaxCatchUpLines": 50,
      // Chat older than this is deleted from the database.
      "PurgeAfterDays": 7
    },

    // Player lists, channel topic and bot status, from the plugins' heartbeats.
    "Status": {
      "ClusterName": "Fire Fly Gaming",
      // A map shows Offline after this many seconds without a heartbeat.
      "OfflineAfterSeconds": 60,
      // Maps silent for this long drop off the lists (retired or renamed).
      "ForgetAfterHours": 24,
      // Server keys never shown, e.g. "TestServer".
      "HideServers": [],
      // Server keys in display order; others follow alphabetically. Empty = alphabetical.
      "ServerOrder": [],

      // {maps_s} / {players_s} / {s} add an "s" except when the count is 1 ("1 Player", "2 Players").
      // Public list: one message the bot keeps edited. Player line placeholders:
      // {platform} {tag} {name} {tribe} {steam_name} {online} {discord} {key} {player_id} {tribe_id}
      "PlayerList": {
        "Enabled": true,
        "ChannelId": "0",
        "RefreshSeconds": 120,
        "Color": "#00FF00",
        "Title": "{cluster}: {maps} Map{maps_s}, {players} Player{players_s}",
        "Server": "{map}: {count} Player{s}",
        "Player": "[{platform}] {tag} {name}{tribe}",
        "TribeFormat": " [{tribe}]",
        "DiscordFormat": "{discord}",
        "NoPlayers": "Online - No Players",
        "Offline": "Offline",
        "Starting": "Starting",
        "Footer": ""
      },

      // Staff list with IDs and FPS, for a private channel. {fps_cur} {fps_avg} in Server.
      "AdminList": {
        "Enabled": false,
        "ChannelId": "0",
        "RefreshSeconds": 120,
        "Color": "#00FF00",
        "Title": "{cluster}: {maps} Map{maps_s}, {players} Player{players_s}",
        "Server": "{map}: {count} player{s}. FPS {fps_cur} (avg {fps_avg})",
        "Player": "({online}) {name}{tribe} ({key}, player {player_id}, tribe {tribe_id}){discord}",
        "TribeFormat": " [{tribe}]",
        "DiscordFormat": " Discord: {discord}",
        "NoPlayers": "Online - No Players",
        "Offline": "Offline",
        "Starting": "Starting",
        "Footer": ""
      },

      // Channel topic (usually the crosschat channel). Discord allows only ~2 topic edits per
      // 10 minutes, so it updates at most every 10 minutes and only when it changed.
      "Topic": {
        "Enabled": true,
        "ChannelId": "0",
        "Format": "{cluster}: {maps} Map{maps_s}, {players} Player{players_s}"
      },

      // Rotating bot status. Types: Playing, Watching, Listening, Competing.
      "Presence": {
        "Enabled": true,
        "RotateSeconds": 60,
        "Statuses": [
          [ "Playing", "with {players} player{players_s}" ],
          [ "Watching", "{maps} map{maps_s}, {players} player{players_s}" ]
        ]
      }
    },

    // Discord <-> game account linking: /link (or the panel's Link button) gives a code, the player
    // types it in game, the bot then gives the verified roles and renames the member.
    "Linking": {
      "Enabled": true,
      // Must match Commands.Link in the plugins' config.json.
      "GameCommand": "/linkDiscord",
      "CodeMinutes": 10,
      // Given on link, removed on unlink (right-click the role > Copy Role ID). The bot's own role
      // must be above these in Server Settings > Roles.
      "VerifiedRoleIds": [],
      "RenameMembers": true,
      "NicknameFormat": "{name}{tribe}",
      "NicknameTribeFormat": " [{tribe}]",
      "UnlinkOnLeave": true,
      // Unlink players not seen in game for this many days (0 = never). Members of KeepGroups
      // (Permissions groups) are never auto-unlinked.
      "AutoUnlinkDays": 30,
      // Needs Lookups:Permissions, e.g. [ "Vacation" ].
      "KeepGroups": []
    },

    // Optional read-only lookups in other plugins' databases. Each one is off while its Database is
    // empty; nothing here is needed to get started. Turn one on for:
    //   Permissions: Linking:KeepGroups (e.g. never auto-unlink Vacation members)
    //   ArkShop / TokenBank: "points" / "tokens" buttons that work while the player is offline
    //   PlayerLogin: "last seen on <map>" in the Player Locator when the player is offline
    // Host/User/Password default to the Database login above. That login needs read access, e.g.
    //   GRANT SELECT ON shop.arkshopplayers TO 'servercomms'@'127.0.0.1';
    // Empty KeyColumn / Table = the plugin's usual name for this game (shown per entry).
    "Lookups": {
      "Permissions": { "Database": "", "Table": "players", "KeyColumn": "", "GroupsColumn": "PermissionGroups" },   // KeyColumn: EOS_Id / SteamId
      "ArkShop":     { "Database": "", "Table": "arkshopplayers", "KeyColumn": "", "PointsColumn": "Points" },       // EosId / SteamId
      "TokenBank":   { "Database": "", "Table": "", "KeyColumn": "", "TokensColumn": "Tokens", "TypeColumn": "TokenType" }, // tokenbank_players / players
      "PlayerLogin": { "Database": "", "Table": "characters", "KeyColumn": "", "ServerColumn": "server_key", "LastSeenColumn": "last_seen" }
    },

    // RCON to the maps (panel buttons, and the RCON commander). The bot tries 127.0.0.1 first, then
    // the MultiHome address each map's plugin reports, and remembers what worked. Servers overrides
    // a map's Host/Port/Password by server key, e.g. "Ragnarok": { "Host": "192.168.1.20" }.
    "Rcon": {
      "Password": "",
      "TimeoutSeconds": 5,
      "Servers": {},

      // RCON Commander panel channel (keep it private: command cards are visible to everyone who
      // can see the channel). "0" = no panel; /rcon still works.
      "CommanderChannelId": "0",
      // true: /rcon replies only to whoever ran it.
      "EphemeralReplies": true,
      // Built in, these always need a Confirm click: DoExit, DestroyWildDinos, DestroyAll,
      // DestroyStructures, the DestroyTribe* commands, KillPlayer, BanPlayer, ...
      // Add other destructive commands here (first word), e.g. "lethaldecay.tribe".
      "ConfirmCommands": [],
      // Who may use RCON: Discord administrators and AdminRoleIds can run anything. Other roles only
      // what's listed for them here (first word of the command; "*" = everything), e.g.
      //   "123456789012345678": [ "ListPlayers", "KickPlayer", "Broadcast", "ServerChat" ]
      "RolePermissions": {}
    },

    // Roles allowed to use /servercomms (Discord administrators always can).
    "AdminRoleIds": [],
    // Optional private channel for notices (broken panel links).
    "AdminLogChannelId": "0",

    // Panels: messages with an embed and buttons that the bot posts and keeps up to date.
    // /servercomms reload applies edits; /servercomms repost <panel> moves one to the bottom.
    //   AdoptMessageId: an existing message by this same bot to take over (old bot's panel).
    //   Buttons: IDs from "Buttons" below, 5 per row; "-" starts a new row.
    "Panels": [
      {
        "Name": "player-tools",
        "ChannelId": "0",
        "AdoptMessageId": "0",
        "Embed": {
          "Title": "Player Tools",
          "Description": "Link your account, then use the buttons. Replies are only visible to you.",
          "Color": "#DEED09",
          "Fields": [
            { "Name": "Link Discord", "Value": "Get a code, then type it in game with /linkDiscord <code>." }
          ]
        },
        "Buttons": [ "link", "unlink", "ids", "-", "points", "locator", "kickme" ]
      }
    ],

    // Buttons. Action: link, unlink, ids, points, tokens, location, rcon, url.
    //   rcon: Command with {player_key} {player_id} {tribe_id}; Target "any" (first online map that
    //     answers), "player" (the map the player is on) or a server key. Reply uses {response};
    //     SuccessReply is shown when the game gives no output (most native commands).
    //   url: Url, or "{panel:player-tools}" for a link to that panel's message.
    //   Reply placeholders: {points} {tokens} {map} {name} {player_key} {player_id} {tribe_id}.
    //   CooldownMinutes: per member. SharedCooldownMinutes: once for everyone per target map.
    //   RequireLinked (default true except link/url), RequireOnline, RequireRoles [role IDs].
    //   OnlyOnMaps [server keys]: with Target "player", only works while the player is on one of them.
    //   Style: Primary, Secondary, Success, Danger. Emoji: unicode or <:name:id>.
    "Buttons": {
      "link":    { "Label": "Link Discord", "Style": "Success", "Emoji": "🔗", "Action": "link" },
      "unlink":  { "Label": "Unlink Discord", "Style": "Danger", "Emoji": "🔓", "Action": "unlink" },
      "ids":     { "Label": "Get my IDs", "Style": "Secondary", "Action": "ids" },
      // Balances through the plugins' own RCON commands: no database setup needed (a map must be online).
      // With Lookups:ArkShop / TokenBank set, "Action": "points" / "tokens" read them directly instead.
      "points":  { "Label": "Point Balance", "Style": "Success", "Emoji": "💵", "Action": "rcon",
                   "Command": "GetPlayerPoints {player_key}", "Target": "any", "CooldownMinutes": 1 },
      "tokens":  { "Label": "Token Balance", "Style": "Success", "Action": "rcon",
                   "Command": "GetPlayerTokens {player_key} Default", "Target": "any", "CooldownMinutes": 1 },
      "locator": { "Label": "Player Locator", "Emoji": "🗺️", "Action": "location", "CooldownMinutes": 1 },
      "kickme":  { "Label": "Kick Me", "Style": "Danger", "Emoji": "🦶", "Action": "rcon", "Command": "KickPlayer {player_key}",
                   "Target": "player", "RequireOnline": true, "CooldownMinutes": 1,
                   "SuccessReply": "You'll be kicked from {map} in a few seconds." }
    }
  },

  "Logging": {
    "LogLevel": {
      // "Debug" also logs Discord's routine reconnects and other detail.
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
